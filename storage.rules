rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event Banners (publicly readable so guest landing pages can display cover art)
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Event Media Uploads (Guest and Organizer photos & videos)
    match /events/{eventId}/{fileName} {
      // Allow read so media can be viewed, previewed, and downloaded
      allow read: if true;

      // Guest & Organizer Upload: Allow media files up to 500 MB
      allow create: if request.resource.size > 0 && request.resource.size <= 524288000;

      // Immutability: Overwrites are forbidden
      allow update: if false;

      // Deletion: Authenticated admin or organizers
      allow delete: if request.auth != null;
    }
  }
}

